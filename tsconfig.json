{
    "compilerOptions": {
        "types": ["mocha", "chai"],
        "typeRoots": ["./node_modules/@types"],
        "lib": ["es2015"],
        "module": "esnext",
        "moduleResolution": "node",
        "noEmit": true,
        "allowImportingTsExtensions": true,
        "target": "esnext",
        "esModuleInterop": true,
        "verbatimModuleSyntax": true
    }
}
